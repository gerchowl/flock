{
  "color": {
    "$type": "color",
    "label": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.960784, 0.960784, 0.968627],
          "hex": "#f5f5f7"
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.682353, 0.682353, 0.698039],
          "hex": "#aeaeb2"
        }
      },
      "tertiary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.431373, 0.431373, 0.45098],
          "hex": "#6e6e73"
        }
      },
      "on-selection": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      },
      "on-selection-secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "alpha": 0.93
        }
      }
    },
    "separator": {

{
  "color": {
    "$type": "color",
    "label": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.819608, 0.819608, 0.839216],
          "hex": "#d1d1d6"
        }
      },
      "tertiary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.596078, 0.596078, 0.615686],
          "hex": "#98989d"
        }
      }
    },
    "separator": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "alpha": 0.35
      }
    },
    "accent": {
      "fill": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0, 0.313725, 0.709804],
          "hex": "#0050b5"
        }
      }
    },
    "link": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.486275, 0.737255, 1.0],
        "hex": "#7cbcff"
      }
    },
    "selection": {
      "active": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0, 0.313725, 0.709804],
          "hex": "#0050b5"
        }
      },
      "inactive": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.282353, 0.282353, 0.290196],
          "hex": "#48484a"
        }
      }
    },
    "focus-ring": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.486275, 0.737255, 1.0],
        "hex": "#7cbcff"
      }
    },
    "destructive": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 0.411765, 0.380392],
        "hex": "#ff6961"
      }
    },
    "status": {
      "green": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.364706, 0.878431, 0.478431],
          "hex": "#5de07a"
        }
      },
      "orange": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 0.701961, 0.25098],
          "hex": "#ffb340"
        }
      },
      "red": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 0.411765, 0.380392],
          "hex": "#ff6961"
        }
      }
    }
  }
}

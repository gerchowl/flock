{
  "color": {
    "$type": "color",
    "label": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.113725, 0.113725, 0.121569],
          "hex": "#1d1d1f"
        },
        "$description": "Primary text. HIG labelColor. Apple HIG, Color: https://developer.apple.com/design/human-interface-guidelines/color"
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.388235, 0.388235, 0.4],
          "hex": "#636366"
        },
        "$description": "Secondary text: captions, metadata. HIG secondaryLabelColor."
      },
      "tertiary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.556863, 0.556863, 0.576471],
          "hex": "#8e8e93"
        },
        "$description": "Disabled text only (WCAG 1.4.3 exempts inactive controls). HIG tertiaryLabelColor."
      },
      "on-selection": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        },
        "$description": "Text and glyphs in an emphasised selected row (selection.active), in place of every other content colour, status colours included. HIG alternateSelectedControlTextColor: https://developer.apple.com/documentation/appkit/nscolor/alternateselectedcontroltextcolor"
      },
      "on-selection-secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "alpha": 0.93
        },
        "$description": "Secondary text in an emphasised selected row, in place of label.secondary. The emphasized background style dims secondary labels (https://developer.apple.com/documentation/appkit/nsview/backgroundstyle/emphasized); 4.5:1 on selection.active allows only a slight dimming."
      }
    },
    "separator": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0, 0.0, 0.0],
        "alpha": 0.1
      },
      "$description": "Hairlines between regions. HIG separatorColor."
    },
    "background": {
      "window": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        },
        "$description": "Content and window background. HIG windowBackgroundColor."
      },
      "sidebar": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.960784, 0.960784, 0.968627],
          "hex": "#f5f5f7"
        },
        "$description": "Sidebar and source-list background (opaque fallback for the sidebar material)."
      }
    },
    "accent": {
      "fill": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.039216, 0.423529, 0.862745],
          "hex": "#0a6cdc"
        },
        "$description": "The accent: selection, focus and the one primary action only. HIG controlAccentColor."
      },
      "on": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"

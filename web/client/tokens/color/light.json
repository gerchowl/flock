        "$description": "Text and icons on an accent fill: the one primary action. A selected row uses label.on-selection."
      }
    },
    "link": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.007843, 0.384314, 0.803922],
        "hex": "#0262cd"
      },
      "$description": "Link and accent-coloured text on window, sidebar and unemphasised selection backgrounds; a shade darker than the accent so it reaches 4.5:1 on all three. HIG linkColor."
    },
    "selection": {
      "active": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.039216, 0.423529, 0.862745],
          "hex": "#0a6cdc"
        },
        "$description": "Emphasised selected row: its content uses label.on-selection and label.on-selection-secondary. HIG selectedContentBackgroundColor."
